# Mastodon API settings
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_access_token_here

# Output Org file path
ORG_FILE_PATH=/absolute/path/to/your/mastodon.org

# Boost (reblog) handling: 'quote' (default) or 'skip'
BOOST_HANDLING=quote

# Org layout mode: 'single' (default, writes to ORG_FILE_PATH) or 'monthly'
# (writes to ORG_DIRECTORY/mastodon/YYYY/MM.org, split by year/month)
# ORG_LAYOUT=single

# Required only when ORG_LAYOUT=monthly. Base directory for the monthly layout.
# ORG_DIRECTORY=/absolute/path/to/your/org
